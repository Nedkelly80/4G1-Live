__pycache__/
*.pyc

# PyInstaller build output (regenerate via build-release.ps1)
build/
dist/

# Packaged installers/portable zips (attach to GitHub Releases instead)
releases/

# Per-machine runtime config written by the app (real defaults live in app.py)
settings.json

# Local safety copies made before risky edits - not history, git is the history
*.bak
*.xpbak
*.bak-before-*
.manus-*/

# pytest run cache
.pytest_cache/
